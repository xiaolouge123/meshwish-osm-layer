  {"name": "Mount Everest", "lon": 86.9250, "lat": 27.9881, "z": [5, 12, 14], "layer": "peak", "within_m": 300,
   "match_re": {"name": "Everest|Sagarmatha|Chomolungma|珠穆朗玛|सगरमाथा"}, "strict": false},

  {"name": "Malta: sea east of Valletta", "lon": 14.60, "lat": 35.85, "z": [5, 10, 14], "layer": "ocean", "contains": true},
