{
 "_comment": [
  "Known places every build is checked at (scripts/tools/pmtiles_tool.py verify). A checkpoint applies",
  "when its point lies inside the archive's bounds. 'contains': the point must lie inside a polygon of",
  "the layer; otherwise a feature matching 'match' (exact) / 'match_re' (regular expression) must pass",
  "within 'within_m' metres. Names are matched loosely: OSM names change, the features do not.",
  "Peaks are checked from z12 up, where no peak is thinned out. 'strict': false marks points not yet",
  "confirmed on a real build: they only warn. Confirm them on the first European and planet builds",
  "(manifest checks.checkpoints) and drop the flag."
 ],
 "checkpoints": [
  {"name": "North Sea", "lon": 3.0, "lat": 55.0, "z": [5, 10, 14], "layer": "ocean", "contains": true},
  {"name": "Mid-Atlantic", "lon": -30.0, "lat": 40.0, "z": [5, 14], "layer": "ocean", "contains": true},
  {"name": "Lake Geneva", "lon": 6.55, "lat": 46.45, "z": [8, 14], "layer": "water", "contains": true,
   "match_re": {"name": "Léman|Genfersee|Geneva"}},
  {"name": "Mont Blanc", "lon": 6.8652, "lat": 45.8326, "z": [5, 12, 14], "layer": "peak", "within_m": 300,
   "match_re": {"name": "Mont Blanc|Monte Bianco"}},
  {"name": "River Thames at London Bridge", "lon": -0.0877, "lat": 51.5079, "z": [8, 12], "layer": "waterway",
   "within_m": 400, "match_re": {"name": "Thames"}, "strict": false},
  {"name": "Rhine at Basel", "lon": 7.5915, "lat": 47.5598, "z": [8, 12], "layer": "waterway", "within_m": 400,
   "match_re": {"name": "Rhein|Rhin"}},
  {"name": "Danube at Budapest", "lon": 19.0438, "lat": 47.4989, "z": [8, 12], "layer": "waterway", "within_m": 400,
