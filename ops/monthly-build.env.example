# /etc/meshwish-osm/monthly-build.env: settings of the monthly build (monthly-build.sh). systemd
# reads it (EnvironmentFile) before dropping to the build user, so keep it root:root 0600.
# KEY=VALUE lines; no "export", no quotes.

# Storage, as for scripts/upload.sh: an R2 API token with Object Read & Write on this bucket only
# (upload and --prune need both).
OSM_S3_URI=s3://<bucket>/osm-layer
OSM_S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto

# Where the checkout, work files (~120 GB at the peak) and logs live. The unit's ReadWritePaths
# must name the same directory.
#OSM_BASE=/srv/osm-layer/monthly
# Which code builds (required): a reviewed tag, moved by hand when a new one is reviewed; "latest"
# follows the newest vX.Y.Z tag on main of OSM_REPO_URL (anyone who can push a tag there then runs
# code on this server). A tag that moved since a run used it is refused.
#OSM_REPO_URL=https://github.com/xiaolouge123/meshwish-osm-layer.git
OSM_REPO_REF=v0.1.3

# Free disk needed before a build, in GB; timeouts in seconds.
#OSM_MIN_FREE_GB=160
#OSM_BUILD_TIMEOUT=18000
#OSM_UPLOAD_TIMEOUT=7200

# The containers' slice (meshwish-osm.slice); empty runs them in docker's default place.
#OSM_DOCKER_SLICE=meshwish-osm.slice
# Container limits (build.sh). The defaults are what the planet was built with on 16 threads /
# 61 GiB (61 min). On a host with other work, e.g. PT_CPUS=8, PT_MEMORY=32g,
# PT_XMX=16g, TOOLS_CPUS=8, TOOLS_MEMORY=8g (slower; see ops/README.md).
#PT_CPUS=16
#PT_MEMORY=56g
#PT_XMX=20g
#TOOLS_CPUS=16
#TOOLS_MEMORY=16g
#PLANET_MIRROR=https://ftp.fau.de/osm-planet/pbf

# Notification: without a URL the outcome is only in the journal, $OSM_BASE/logs/,
# $OSM_BASE/last-run.json and the bucket's logs/. Formats: slack ({"text"}), discord
# ({"content"}), feishu (Feishu/Lark custom bot text message). NOTIFY_ON: failure, always, never.
#NOTIFY_WEBHOOK_URL=
#NOTIFY_WEBHOOK_FORMAT=slack
#NOTIFY_ON=failure
