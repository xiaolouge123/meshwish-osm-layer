# Pinned versions. Every build manifest records these, so a layer can be traced to the exact
# rules and tools that made it; change them only together with a test build.

# Version of this repository's scripts; also goes into the User-Agent of every download.
LAYER_TOOLS_VERSION=0.1.3

# planetiler 0.10.3-SNAPSHOT (git ee9f808cf726b7e57a0017320a107e95087a85a9, built
# 2026-11-11), multi-arch index (linux/amd64 and linux/arm64). This is the build the rules were
# validated with; move to a release (v0.10.3 or later) once one is out, after a test build.
PLANETILER_IMAGE=ghcr.io/onthegomap/planetiler@sha256:11d2c288454f8776f05b7c4c61b529971ccbb4d0584fbe9bf8e892b2f270481b

# Base of the tools image (docker/tools.Dockerfile): osmium-tool and python3 from Debian 13.
TOOLS_BASE_IMAGE=debian:trixie-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2

# S3 client for scripts/upload.sh and scripts/fetch-previous.sh.
AWSCLI_IMAGE=amazon/aws-cli:2.40.2@sha256:acc32af784911165a8e78b63950625d174ba79b800a66a436c974689c87cd755
